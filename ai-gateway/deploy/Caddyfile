bluem.myvnc.com {
    request_body {
        max_size 128KB
    }
    @api path /api/chat /api/tags /healthz
    handle @api {
        reverse_proxy 127.0.0.1:8081 {
            transport http {
                dial_timeout 5s
                response_header_timeout 26m
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
