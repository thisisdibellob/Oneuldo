[Unit]
Description=Oneuldo public HTTPS proxy
After=network-online.target oneuldo-ai.service
Wants=network-online.target oneuldo-ai.service

[Service]
User=oneuldo-caddy
Group=oneuldo-caddy
WorkingDirectory=/var/lib/oneuldo-caddy
Environment=HOME=/var/lib/oneuldo-caddy
Environment=XDG_DATA_HOME=/var/lib/oneuldo-caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/oneuldo-caddy/config
ExecStart=/opt/oneuldo-caddy/caddy run --config /etc/oneuldo-caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=oneuldo-caddy
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
