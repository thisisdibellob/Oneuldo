[Unit]
Description=Oneuldo Spring AI Gateway
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
User=oneuldo-ai
Group=oneuldo-ai
WorkingDirectory=/var/lib/oneuldo-ai
Environment=DJL_CACHE_DIR=/var/lib/oneuldo-ai/djl
ExecStart=/usr/bin/java -Xms64m -Xmx384m -jar /opt/oneuldo-ai/oneuldo-ai-gateway.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
StateDirectory=oneuldo-ai
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
