{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneuldo.local/schemas/market-replay-trace.json",
  "title": "Oneuldo market UI intention trace (AI review flow only)",
  "type": "object",
  "properties": {
    "traceSchemaVersion": {
      "enum": [
        "1",
        "2"
      ]
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "personaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "personaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "seed": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "number"
        }
      ]
    },
    "generationPolicy": {
      "enum": [
        "stochastic",
        "llm"
      ]
    },
    "policyVersion": {
      "enum": [
        "3",
        "4",
        "5"
      ]
    },
    "generation": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reproducibility": {
          "enum": [
            "seed-and-snapshot",
            "captured-trace"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "model",
        "reproducibility"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "missionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "completionMode": {
          "const": "ai-review"
        }
      },
      "required": [
        "snapshotId",
        "completionMode"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "experienceMode": {
      "enum": [
        "first-play",
        "revisit"
      ]
    },
    "attentionExperience": {
      "type": "object",
      "properties": {
        "layoutKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "memory": {
          "type": "object"
        },
        "source": {
          "const": "planned-trace"
        }
      },
      "required": [
        "layoutKey",
        "memory",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "traceSchemaVersion",
    "traceId",
    "personaId",
    "personaVersion",
    "seed",
    "generationPolicy",
    "policyVersion",
    "target",
    "steps"
