{
  "name": "oneuldo-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:tunnel": "node scripts/start-expo-tunnel.mjs",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:go": "expo start --go --ios --localhost",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "llama:android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-llama-android.ps1",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_PATH=./node_modules jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "oneuldo-llama-runtime": "file:./modules/oneuldo-llama-runtime",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/ngrok": "4.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^oneuldo-llama-runtime$": "<rootDir>/modules/oneuldo-llama-runtime/index.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
