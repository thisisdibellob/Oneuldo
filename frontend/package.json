{
  "name": "oneuldo-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:tunnel": "node scripts/start-expo-tunnel.mjs",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "llama:android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-llama-android.ps1",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_PATH=./node_modules jest --runInBand"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "oneuldo-llama-runtime": "file:./modules/oneuldo-llama-runtime",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-system-ui": "~57.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/ngrok": "4.1.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^oneuldo-llama-runtime$": "<rootDir>/modules/oneuldo-llama-runtime/index.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
