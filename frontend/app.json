{
  "expo": {
    "name": "오늘도",
    "slug": "onuldo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/source/Logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onuldo.app"
    },
    "android": {
      "package": "com.onuldo.app",
      "adaptiveIcon": {
        "backgroundColor": "#D3FFE5",
        "foregroundImage": "./assets/images/source/Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/source/Logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain",
          "image": "./assets/images/source/Logo.png",
          "imageWidth": 208
        }
      ]
    ]
  }
}
