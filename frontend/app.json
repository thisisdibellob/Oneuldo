{
  "expo": {
    "name": "오늘도",
    "slug": "oneuldo",
    "scheme": "oneuldo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain",
      "image": "./assets/images/source/Logo.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oneuldo.app"
    },
    "android": {
      "package": "com.oneuldo.app",
      "adaptiveIcon": {
        "backgroundColor": "#D3FFE5",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/app-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-dev-client",
      "expo-asset",
      "./plugins/with-qwen-model"
    ]
  }
}
