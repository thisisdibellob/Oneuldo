{
  "name": "oneuldo-market-simulator",
  "version": "2.0.0",
  "private": true,
  "description": "Persona intent traces and real-time replay through the development web app",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.cjs",
    "cli": "node cli.cjs",
    "replay": "node cli.cjs interactive",
    "test": "node --test test/*.test.cjs",
    "typecheck": "node ../frontend/node_modules/typescript/bin/tsc -p tsconfig.json",
    "verify": "node scripts/verify.cjs",
    "verify:persona": "node scripts/verify-persona.cjs",
    "verify:attention": "node scripts/verify-attention.cjs",
    "verify:personalities": "node scripts/verify-personalities.cjs"
  }
}
