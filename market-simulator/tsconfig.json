{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "ignoreDeprecations": "6.0", "strict": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "typeRoots": ["../frontend/node_modules/@types"], "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
