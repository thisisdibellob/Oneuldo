# 이 파일을 application-local.properties로 복사해서 사용합니다.
# 실제 비밀번호는 파일에 작성하지 않고 DB_PASSWORD 환경변수로 입력합니다.

# 로컬 PostgreSQL 연결 주소
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5433/oneuldo}

# 로컬 PostgreSQL 사용자 이름
spring.datasource.username=${DB_USERNAME:oneuldo}

# 로컬 PostgreSQL 비밀번호
spring.datasource.password=${DB_PASSWORD}

# PostgreSQL JDBC 드라이버
spring.datasource.driver-class-name=org.postgresql.Driver